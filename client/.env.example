# Base URL of the backend API (local development default).
# Production build value lives in .env.production (VITE_API_BASE_URL), which
# Vite loads automatically for `vite build` and never for `vite dev`.
VITE_API_BASE_URL=http://localhost:4000

# Default map center/zoom shown before a user submits a centroid. Not baked
# into app logic — override these to focus the map on a different region.
# Defaults below center on India.
VITE_MAP_DEFAULT_LAT=22.9734
VITE_MAP_DEFAULT_LNG=78.6569
VITE_MAP_DEFAULT_ZOOM=5
