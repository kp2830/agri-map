PORT=4000

# Google Agricultural Understanding API (ALU + AMED) — required for the production
# /agriculture/fields flow (server/src/services/google/agriculturalUnderstandingClient.ts).
# A real Google API key, not a service-account JSON path.
AGRICULTURAL_UNDERSTANDING_API_KEY=

# Optional: Sentinel-1/Sentinel-2 feature-extraction backend for the custom Sunflower model
# (server/src/services/agricultural/sunflower/). Neither is currently configured anywhere.
# Set EITHER the GEE_* trio OR the CDSE_* pair — see featureExtraction.ts's
# isSatellitePipelineConfigured() docstring for exact setup steps for each.
# GEE_PROJECT_ID=
# GEE_SERVICE_ACCOUNT_EMAIL=
# GEE_SERVICE_ACCOUNT_KEY=
# CDSE_CLIENT_ID=
# CDSE_CLIENT_SECRET=

# Optional: enables the isolated ESA WorldCereal research integration
# (server/src/services/agricultural/worldcereal/, routes under /research/worldcereal).
# Off by default. Uses the same CDSE_CLIENT_ID/CDSE_CLIENT_SECRET above. Real openEO/CDSE jobs
# take 5-12 minutes and consume real processing credits (a separate quota from the Statistical
# API PU used above) -- see training/esa/worldcereal_agrimap_100_field_evaluation.md.
# ENABLE_WORLDCEREAL_RESEARCH=

# Optional: overrides the Sunflower likeness override threshold (0-1) used by
# overridePolicy.ts. Defaults to the exported model artifact's own LOFO-calibrated
# "conservative" threshold (see likenessModel.ts's DEFAULT_SUNFLOWER_LIKENESS_THRESHOLD) —
# only set this to tune the threshold without redeploying the model artifact.
# SUNFLOWER_OVERRIDE_THRESHOLD=
